# ws://{botHost}:{botPort}/onebot/v11/ws/
# botHost
HOST=127.0.0.1
# botPort
PORT=14515
DRIVER=~fastapi+~websockets+~httpx
# 环境
ENVIRONMENT=dev
LOG_LEVEL=DEBUG
ONEBOT_ACCESS_TOKEN=""
# 匹配指令前缀(只有这里包含之后，在每个插件里面才能通过startswith(("!", "/"), ignorecase=False)动态配置)
COMMAND_START = ["","/","!","！"]
LOCALSTORE_USE_CWD=true

# 管理员账户
SUPERUSERS=[""]

# 管理面板健康告警（通过 OneBot 私聊发送；留空 QQ 列表则使用 SUPERUSERS）
ADMIN_ALERTS_ENABLED=true
ADMIN_ALERT_QQS=[]
ADMIN_ALERT_COOLDOWN_SECONDS=21600
# 可选：通用 HTTP Webhook（不依赖 Telegram），POST JSON 到该地址
ADMIN_ALERT_WEBHOOK=""
ADMIN_ALERT_WEBHOOK_TOKEN=""
ADMIN_ALERT_WEBHOOK_TIMEOUT=10

# 数据库URL地址(默认为127.0.0.1)
DATABASE_URL = "127.0.0.1"
# 数据库 库名(⚠ 必填)
DATABASE_DB = ""
# 数据库连接账号(⚠ 必填)
DATABASE_USERNAME = ""
# 数据库连接密码(⚠ 必填)
DATABASE_PASSWORD = ""
# 数据库连接端口(默认为3306)
DATABASE_PORT = 3306

# OAuth2 平台绑定
OAUTH_CLIENT_ID=""
OAUTH_CLIENT_SECRET=""
OAUTH_BASE_URL=""
OAUTH_BOT_PUBLIC_URL=""

# AI 聊天插件（默认 DeepSeek，OpenAI 兼容接口）
CHAT_ENABLED=true
CHAT_LLM_API_BASE="https://api.deepseek.com/v1"
CHAT_LLM_API_KEY=""
# deepseek-flash 当前路由到 DeepSeek-V4.1-Flash-1017
CHAT_LLM_MODEL="deepseek-flash"

# 拟人化（默认开启；关闭后退回原来的直接生成 + 立即发送）
CHAT_HUMANIZE_ENABLED=true
CHAT_TYPING_SIMULATION=true
CHAT_TYPING_CHARS_PER_SECOND=9.0
CHAT_TYPING_MAX_DELAY=6.0
CHAT_READ_DELAY_MIN=0.45
CHAT_READ_DELAY_MAX=1.8
CHAT_SPLIT_PROBABILITY=0.25
CHAT_ANTI_REPEAT_ENABLED=true
CHAT_ANTI_REPEAT_THRESHOLD=0.78
CHAT_ANTI_REPEAT_WINDOW=6
CHAT_MEMORY_RETRIEVAL_ENABLED=true

# 资料卡 / 生日 / 点赞 / QQ 空间（通过 OneBot/NapCat）
CHAT_PROFILE_ENABLED=true
CHAT_PROFILE_REFRESH_HOURS=48
CHAT_PROFILE_PROMPT_ENABLED=true
CHAT_BIRTHDAY_ENABLED=true
CHAT_BIRTHDAY_HOUR=9
CHAT_BIRTHDAY_MIN_FAVORABILITY=10
CHAT_FAVOR_LEDGER_ENABLED=true
CHAT_FAVOR_PENALTY_WINDOW_SECONDS=600
CHAT_FAVOR_PENALTY_CAP=6.0
# 对话评测集：采样保存真实触发场景（上下文+消息+回复），供标注与回归对比
CHAT_EVAL_SAMPLE_ENABLED=true
CHAT_EVAL_SAMPLE_RATE=0.15
CHAT_EVAL_MAX_SAMPLES=400
# 回复长度控制：按触发类型/关系/时段/消息密度给目标字数区间
CHAT_REPLY_LENGTH_CONTROL=true
# 主动行为护栏：静默时段（如 23:30-08:00，可逗号分隔多段）内不插话/不冷场应答
CHAT_PROACTIVE_QUIET_HOURS=
# 统一自我记忆：群聊里知道自己有电脑/手机、记得真实做过的操作（self_memory）
CHAT_SELF_MEMORY_ENABLED=true
# 每天 04:30 从近一周电脑/手机经历提炼稳定自我事实（习惯/偏好/技能）
CHAT_SELF_MEMORY_DISTILL=true
# 模型路由：记忆固化用更便宜的模型（留空=主模型）；主模型重试用尽后的降级模型（留空=不降级）
CHAT_CONSOLIDATE_MODEL=
CHAT_FALLBACK_MODEL=
# 成本上限：每日 Token 上限（0=不限），超过后停止主动插话/冷场应答（被@不受影响）
CHAT_DAILY_TOKEN_CAP=0
# 意图路由/检索判定等 JSON 小任务用便宜模型（留空=主模型）
CHAT_UTILITY_MODEL=
# 建议主模型为 Gemini 时，把内部 JSON 任务固定到 DeepSeek，避免 Gemini 把推理过程写进 JSON
CHAT_PROFILE_LIKE_ENABLED=false
CHAT_PROFILE_LIKE_PROBABILITY=0.15
CHAT_PROFILE_LIKE_TIMES=10
CHAT_PROFILE_LIKE_COOLDOWN_HOURS=24
CHAT_PROFILE_LIKE_DAILY_LIMIT=10
CHAT_QZONE_ENABLED=false
CHAT_QZONE_START_HOUR=10
CHAT_QZONE_END_HOUR=23
# 旧版固定概率已弃用；现在使用下面的时间概率
CHAT_QZONE_PROBABILITY=0.25
CHAT_QZONE_DAILY_LIMIT=1
CHAT_QZONE_MIN_INTERVAL_HOURS=2
CHAT_QZONE_PROBABILITY_RAMP_HOURS=96
CHAT_QZONE_MAX_PROBABILITY=0.8
CHAT_QZONE_HOME_EVENT_PROBABILITY=0.08
CHAT_QZONE_OUTSIDE_EVENT_PROBABILITY=0.22
CHAT_QZONE_SLEEP_ONSET_PROBABILITY=0.12
CHAT_QZONE_SLEEP_ONSET_MINUTES=30
CHAT_QZONE_EVENT_MAX_AGE_MINUTES=120
CHAT_QZONE_IMAGE_PROBABILITY=0.35
CHAT_QZONE_EVENT_IMAGE_PROBABILITY=0.75
CHAT_QZONE_COMMENT_ENABLED=true
CHAT_QZONE_COMMENT_INTERVAL_MINUTES=2
CHAT_QZONE_COMMENT_HOT_MINUTES=10
CHAT_QZONE_COMMENT_HOT_INTERVAL_SECONDS=30
CHAT_QZONE_COMMENT_MAX_PER_TICK=0
CHAT_QZONE_COMMENT_MAX_PER_DAY=0

# AI 配图（OpenAI 兼容 /images/generations）
CHAT_IMAGE_ENABLED=true
CHAT_IMAGE_PROVIDER=qwen
CHAT_IMAGE_API_BASE="https://maas.qianwenaiapi.com/compatible-mode/v1"
CHAT_IMAGE_API_KEY=""
CHAT_IMAGE_MODEL="qwen-image-3.0-pro"
CHAT_IMAGE_SIZE=1024x1024
CHAT_IMAGE_PROMPT_SUFFIX="anime style, 2D illustration, cel shading, clean line art, soft colors, wholesome, no photorealistic, no 3D render"
CHAT_IMAGE_NEGATIVE_PROMPT="photorealistic, realistic photo, 3D render, CGI, text, watermark, logo, low quality, bad anatomy, extra fingers, nsfw"
CHAT_SELF_STICKER_ENABLED=true
CHAT_SELF_STICKER_PROBABILITY=0.12
CHAT_SELF_STICKER_COOLDOWN_SECONDS=1800
CHAT_MOOD_ENABLED=true
CHAT_ACTIVITY_ENABLED=true
CHAT_LIFE_ENABLED=true
CHAT_LIFE_SHARE_ENABLED=true
CHAT_LIFE_SHARE_GROUPS=""
CHAT_LIFE_SHARE_INTERVAL_MINUTES=20
CHAT_LIFE_SHARE_QUIET_MINUTES=45
CHAT_LIFE_SHARE_PROBABILITY=0.35
CHAT_ACTIVITY_INTERVAL_MINUTES=75
CHAT_MOOD_CUES_ENABLED=true
CHAT_WEB_SEARCH_ENABLED=true
CHAT_WEB_SEARCH_AUTO_DECIDE=true
CHAT_WEB_SEARCH_PLANNER_TIMEOUT=12
CHAT_WEB_SEARCH_MAX_RESULTS=4
CHAT_WEB_SEARCH_TIMEOUT=20
CHAT_WEB_SEARCH_API_BASE=""
CHAT_NIGHT_QUIET_ENABLED=true
CHAT_NIGHT_START_HOUR=0
CHAT_NIGHT_END_HOUR=7

# Telegram Bot（nonebot-adapter-telegram，长轮询）
# token 在 @BotFather 创建机器人获取，格式 123456789:AAxxxxxx；留空则不启用
TELEGRAM_TOKEN=""
TELEGRAM_API_SERVER="https://api.telegram.org/"
TELEGRAM_IS_WEBHOOK=false
# 大陆访问 Telegram 需配置代理
TELEGRAM_PROXY=""

# 投稿推送插件（Telegram 投稿 -> 管理员审核 -> 发布到频道）
POSTER_ENABLED=true
POSTER_CHANNEL_ID=""
POSTER_ADMIN_IDS=[]
POSTER_REVIEW_CHAT_ID=""
POSTER_COMMAND=post
POSTER_CANCEL_COMMAND=cancel
POSTER_TAGS=["NSFW","文案","文章"]
POSTER_STATS_COMMAND=poststats
POSTER_WL_COMMAND=postwl
POSTER_BL_COMMAND=postbl
POSTER_ANON_FLAGS=["匿名","anon"]
POSTER_WHITELIST_IDS=[]
POSTER_BLACKLIST_IDS=[]
POSTER_TIMEOUT_SECONDS=600

# Agent 手机控制桥（仅回环地址；令牌不应提交到仓库）
AGENT_COMPUTER_URL="http://127.0.0.1:8766"
AGENT_COMPUTER_TOKEN=""

# 网络流行语/群黑话长期学习（候选词不会直接进入提示词）
CHAT_SLANG_ENABLED=true
CHAT_SLANG_LEARN_HOURS=2
CHAT_SLANG_WEB_HOURS=3

# 群聊短句偶尔只用表情回应，不再追加文字
CHAT_REACTION_ONLY_ENABLED=true
CHAT_REACTION_ONLY_PROBABILITY=0.12

CHAT_POKE_ENABLED=true
CHAT_POKE_COOLDOWN_SECONDS=120
CHAT_POKE_DAILY_LIMIT=12

CHAT_SLANG_SUGGESTION_PROBABILITY=0.25

# 小黑盒自动化账号名（仅私有配置填写，不要提交真实账号）
XIAOHEIHE_ACCOUNT=""
